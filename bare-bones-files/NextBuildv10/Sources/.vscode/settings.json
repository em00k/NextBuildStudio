{
    "window.commandCenter": true,
    "workbench.colorTheme": "Bearded Theme Stained Blue",
    "cursor.composer.shouldChimeAfterChatFinishes": true,
    "git.enableSmartCommit": true,
    "git.openRepositoryInParentFolders": "never",
    "nextbuild-viewers.linting.rootFolderForIncludes": "NextBuildv10/Sources",
    "nextbuild-viewers.playpt3Path": "Tools/playpt3",
    "workbench.iconTheme": "nextbuild-icons",
    "files.autoSave": "afterDelay",
    "explorer.confirmDragAndDrop": false,
    "javascript.updateImportsOnFileMove.enabled": "always",
    "cursor.cpp.disabledLanguages": [
        "markdown",
        "plaintext"
    ],
    "editor.minimap.enabled": true,
    "php.validate.executablePath": "/usr/bin/php",
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.pinnedTabsOnSeparateRow": true,
    "workbench.editor.wrapTabs": true,
    "workbench.iconTheme": "nextbuild-icons",
    "workbench.colorCustomizations": {

        "tab.activeBackground": "#880202c9",
        "tab.inactiveBackground": "#232324",
        "tab.inactiveForeground": "#e7e7e7",
        "tab.activeForeground": "#f1ff32",
        "tab.selectedForeground": "#f1ff32"
    },
    "editor.tokenColorCustomizations": {
    "textMateRules": [
        { "scope": "keyword.mnemonic.z80", "settings": { "foreground": "#FF6E6E", "fontStyle": "bold" } },
        { "scope": "variable.register.8bit.z80", "settings": { "foreground": "#8BE9FD" } },
        { "scope": "variable.register.16bit.z80", "settings": { "foreground": "#50FA7B" } },
        { "scope": "meta.address.indirect.z80", "settings": { "foreground": "#BD93F9" } },
        { "scope": "constant.numeric.hex.z80", "settings": { "foreground": "#F1FA8C" } },
        { "scope": "keyword.mnemonic.nextreg.z80",            "settings": { "foreground": "#FF6E6E", "fontStyle": "bold" } },
        { "scope": "constant.language.nextreg.name.z80",      "settings": { "foreground": "#BD93F9" } },
        { "scope": "support.function.nextreg.nextbuild",      "settings": { "foreground": "#FF79C6", "fontStyle": "bold" } },

        { "scope": "keyword.preprocessor.nextbuild", "settings": { "foreground": "#7FDBCA", "fontStyle": "bold" } },
        { "scope": "meta.precompiler.asm.nextbuild", "settings": { "foreground": "#ca04d5", "fontStyle": "bold" } },
        { "scope": "comment.line.apostrophe.nextbuild", "settings": { "foreground": "#97d70d", "fontStyle": "italic " } },
    ]
    },
        "actionButtons": {

            "commands": [

        {
            "name": "$(book) Help",
            "color": "#ffeeaa",
            "useVsCodeApi": true,
            "command": "nextbuild-viewers.showKeywordHelp",
            "args": ["Index"]
        } ,
        {
            "name": "$(gear) New Project",
            "color": "#e7e7e7",
            "useVsCodeApi": true,
            "command": "nextbuild-viewers.createNewProject"
        },
        {
        "name": "$(play) Compile & Run",
        "color": "#39ff14",
        "useVsCodeApi": true,
        "command": "workbench.action.tasks.runTask",
        "args": ["Build Source & Run CSpect"]
    },
    {
        "name": "$(rocket) Run Emulator", 
        "color": "#00eaff",
        "useVsCodeApi": true,
        "command": "workbench.action.tasks.runTask",
        "args": ["Start CSpect"]
    },
    {
        "name": "$(chrome-restore) Build Modules",
        "color": "#ff6b35", 
        "useVsCodeApi": true,
        "command": "workbench.action.tasks.runTask",
        "args": ["MODULE : Build all modules & run"]
    },
    {
        "name": "$(package) Single Module",
        "color": "#8e44ad",
        "useVsCodeApi": true,
        "command": "workbench.action.tasks.runTask", 
        "args": ["MODULE : Build single module & run"]
    },
    {
        "name": "$(cloud-upload) HDF Sync",
        "color": "#3498db",
        "useVsCodeApi": true,
        "command": "workbench.action.tasks.runTask",
        "args": ["Sync Files to HDF"]
    },
    {
        "name": "$(clone) Start NextZXOS",
        "color": "#e74c3c",
        "useVsCodeApi": true,
        "command": "workbench.action.tasks.runTask",
        "args": ["Start NextZXOS"]
    },
    {
    "name": "$(folder-opened) Explorer",
    "color": "#f39c12",
    "useVsCodeApi": true,
    "command": "workbench.action.files.revealActiveFileInWindows"
    },
    {
        "name": "$(gear) Settings",
        "color": "#95a5a6",
        "useVsCodeApi": true,
        "command": "workbench.action.tasks.runTask",
        "args": ["Edit Config"]
    }
    ],
    "defaultColor": "white",
    "reloadButton": "↻",
    "loadNpmCommands": false
    },
}
